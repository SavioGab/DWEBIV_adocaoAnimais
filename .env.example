# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O arquivo .env NÃO deve ir para o GitHub (já está no .gitignore).

# Supabase -> Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_ou_anon
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_SECRETA

# Chave que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria

# Endereço do site (usado nos links enviados por e-mail)
BASE_URL=http://127.0.0.1:5000

# 1 = modo debug (só em desenvolvimento) | 0 = desligado
FLASK_DEBUG=1