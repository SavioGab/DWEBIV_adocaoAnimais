# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O arquivo .env NÃO deve ir para o GitHub (já está no .gitignore).

# Supabase -> Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_ou_anon
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_SECRETA

# Chave que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria

# Captcha (Cloudflare Turnstile) - OBRIGATÓRIO no cadastro, login
# e recuperação de senha.
# Os valores abaixo são chaves de TESTE da Cloudflare (sempre aprovam),
# servem para desenvolver. Em produção, crie um widget gratuito em
# https://dash.cloudflare.com -> Turnstile e troque pelas suas chaves.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Endereço do site (usado nos links enviados por e-mail)
BASE_URL=http://127.0.0.1:5000

# 1 = modo debug (só em desenvolvimento) | 0 = desligado
FLASK_DEBUG=1
